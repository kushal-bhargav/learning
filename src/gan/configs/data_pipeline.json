{
  "sources": [
    {
      "provider": "huggingface_dataset",
      "name": "Synthetic Greeting Cards",
      "dataset_name": "gauravs101/synthetic-greeting-cards",
      "split": "train",
      "image_columns": [
        "image",
        "card_image",
        "img",
        "png"
      ],
      "text_columns": [],
      "occasion_columns": [],
      "query_label": "synthetic-greeting-cards",
      "license": "Hugging Face dataset license; verify dataset README before publication",
      "license_url": "https://huggingface.co/datasets/gauravs101/synthetic-greeting-cards",
      "max_images": 5000,
      "min_width": 128,
      "min_height": 128,
      "trust_remote_code": false,
      "keep_in_memory": false,
      "artifact_type": "greeting_card"
    }
  ],
  "paths": {
    "raw_dir": "data/gan/raw",
    "processed_dir": "data/gan/processed",
    "metadata_path": "data/gan/metadata.jsonl",
    "embeddings_path": "data/gan/clip_embeddings.npy",
    "rejections_path": "data/gan/rejections.jsonl",
    "contact_sheet_path": "experiments/sample_clustered_images.jpg",
    "run_report_path": "experiments/data_pipeline_run.json",
    "data_card_path": "experiments/DATA_CARD.md"
  },
  "quality_gates": {
    "minimum_records": 100
  },
  "preprocessing": {
    "resolution": 256,
    "format": "PNG",
    "crop": "center_square",
    "centering": [
      0.5,
      0.5
    ],
    "resample": "LANCZOS"
  },
  "clip": {
    "model_name": "ViT-B-32",
    "pretrained": "openai",
    "device": "auto",
    "batch_size": 64
  },
  "clustering": {
    "clusters": 6,
    "seed": 2026,
    "max_iterations": 100,
    "emotion_prompts": {
      "joy": "a joyful celebratory illustration suitable for a happy gift",
      "nostalgia": "a nostalgic sentimental illustration suitable for a memory gift",
      "gratitude": "a warm illustration expressing gratitude and appreciation",
      "humor": "a playful humorous illustration suitable for a funny gift",
      "comfort": "a calm comforting illustration suitable for emotional support",
      "other": "a decorative illustration with a neutral mood"
    }
  },
  "split": {
    "validation_fraction": 0.1,
    "seed": 2026
  },
  "preview": {
    "sample_count": 48,
    "columns": 6,
    "thumbnail_size": 160,
    "label_height": 58
  }
}
